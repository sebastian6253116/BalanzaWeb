# Copy this file to .env and edit it before running docker compose.
# docker compose reads .env from the same directory as docker-compose.yml.

# Public domain served by Caddy. DNS must point at the VPS and ports 80/443
# must be open so Caddy can issue the certificate automatically.
DOMAIN=balanza.example.com

# First admin account. Only used when the database has no users yet; after the
# first start these can stay empty (the bootstrap step does nothing).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-exposing
BOOTSTRAP_ADMIN_NAME=Administrador
